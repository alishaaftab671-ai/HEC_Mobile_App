        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "extra": {
      "eas": {
        "projectId": "bf252f8e-1635-4f5e-b054-4384a27d2a25"
      }
    },
    "owner": "alisha-aftab",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bf252f8e-1635-4f5e-b054-4384a27d2a25"
    }
  }
